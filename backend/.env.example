# Copy to backend/.env for local dev. In Coolify, set these as service env vars.

# Node
TZ=Asia/Kolkata
PORT=3333
HOST=0.0.0.0
NODE_ENV=production

# App
LOG_LEVEL=info
# Generate with: node ace generate:key
APP_KEY=base64:GENERATE_ME_WITH_ace_generate_key
APP_URL=http://localhost:3333

# Session
SESSION_DRIVER=cookie

# CORS — comma-separated frontend origins allowed to call the API (production only)
CORS_ORIGIN=https://your-frontend-domain.com

# Email (Resend)
RESEND_API_KEY=re_your_key
# Sandbox sender only delivers to the Resend account owner until a domain is verified:
FROM_EMAIL=Grave the Crave <onboarding@resend.dev>

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
